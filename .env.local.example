# Copy to .env.local (never committed) and uncomment what you need.
# The toolkit reads this file literally: no $ expansion, no command substitution.
# Other names are ignored by the toolkit; wiki-capture redacts their values from captures.

# Storage that holds vzdump backups. Without it, pve-health skips backups and
# pve-backup needs --storage.
# PVE_BACKUP_STORAGE=nas-backup

# Storage use (%) above which pve-health and pve-capacity report CRIT.
# PVE_STORAGE_WARN_PCT=85

# Age (days) above which a guest's latest backup is reported.
# PVE_BACKUP_MAX_AGE_DAYS=2

# Password fallback (docs/ssh-access.md §9): 1 enables `sshpass -e`. Keys are preferred.
# HOMELAB_SSHPASS=0
# SSHPASS=

# Audit log of each run (actions, not reports). Directory defaults to logs/ (gitignored); a
# relative path is under the repository.
# HOMELAB_LOG=1
# HOMELAB_LOG_DIR=logs
