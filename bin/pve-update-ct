#!/usr/bin/env bash
# pve-update-ct: package upgrade inside one running container (changing tool).
set -euo pipefail
# shellcheck source=../lib/pve/init.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/pve/init.sh"

usage() {
  cat <<'EOF'
Usage: pve-update-ct <vmid> [--node NODE] [--snapshot] [--simulate] [--dry-run] [--yes]

Upgrades the packages of one running container: apt (debian, ubuntu, devuan) or apk (alpine).
Before the plan it simulates the upgrade inside the container and shows how many packages it
would upgrade and which it would remove; a real run refreshes the package lists, simulates again
and stops a --yes run when the removals changed. --snapshot takes pre-update-<date>-<time> first,
as the rollback. --simulate prints the simulation and stops. A simulation inside a container
needs "pct exec", so it runs through the admin alias without --yes; nothing else does.
EOF
}

# sim_valid PM: stdin is the output of a real simulation (apt summary line, apk "OK:" line).
sim_valid() {
  if [[ "$1" == apk ]]; then
    grep -q '^OK:'
  else
    grep -Eq "$PVE_APT_SUMMARY_RE"
  fi
}

# simulate LABEL: a fresh simulation inside the container ($node, $id, $pm, $sim), read only when it
# can be trusted: a failed command, a missing summary line or (apt) a "N to remove" that differs
# from the Remv lines fails the check. Sets SIM_COUNT (packages to upgrade or install) and
# PVE_REMOVALS, PVE_REMOVAL_COUNT (what it would remove: Remv lines, apk "Purging" lines).
simulate() {
  local name="${1:+$1 }simulation" out
  out="$(pve_ct_exec_admin "$node" "$id" "${sim[@]}")" || pve_check_fail "the $name failed in ct $id"
  if [[ "$pm" == apt ]]; then
    pve_sim_removals "in ct $id" "$1" "$out"
  else
    sim_valid apk <<< "$out" || pve_check_fail "the $name in ct $id returned no summary line"
    PVE_REMOVALS="$(pve_parse_apk_purges <<< "$out" | LC_ALL=C sort | paste -sd' ' -)"
    PVE_REMOVAL_COUNT="$(pve_parse_apk_purges <<< "$out" | awk 'END { print NR }')"
  fi
  SIM_COUNT="$(pve_parse_pkg_sim "$pm" <<< "$out")"
}

# show_simulation LABEL: the check line with what the simulated upgrade would change.
show_simulation() {
  local what="the $1 simulation in ct $id: $SIM_COUNT package(s) to upgrade or install"
  if ((PVE_REMOVAL_COUNT == 0)); then
    pve_check_ok "$what, none to remove"
  else
    pve_check_warn "$what; the upgrade would remove $PVE_REMOVAL_COUNT package(s): $PVE_REMOVALS"
  fi
}

main() {
  local -a orig=("$@")
  local id="" snapshot=0 simulate=0 node config ostype pm status out snap rc refresh before total ran
  local -a sim update upgrade
  pve_cli_parse "$@"
  set -- "${PVE_ARGS[@]}"
  while (($# > 0)); do
    case "$1" in
      --snapshot) snapshot=1; shift ;;
      --simulate) simulate=1; shift ;;
      -*) pve_usage_error "unknown option: $1" ;;
      *)
        [[ -z "$id" ]] || pve_usage_error "expected one VMID"
        id="$1"
        shift
        ;;
    esac
  done
  [[ "$id" =~ ^[0-9]{1,9}$ ]] || pve_usage_error "expected a VMID"
  ((simulate == 0 || PVE_DRY_RUN == 0)) || pve_usage_error "--simulate and --dry-run cannot be combined"
  ((simulate == 0 || snapshot == 0)) || pve_usage_error "--simulate and --snapshot cannot be combined"
  pve_init pve-update-ct "${orig[@]}"
  pve_find_guest "$id" || exit 1
  node="$PVE_GUEST_NODE"
  [[ "$PVE_GUEST_TYPE" == ct ]] || pve_check_fail "$id is a VM: pve-update-ct updates containers only"
  config="$(pve_collect "$node" pct config "$id")" || pve_check_fail "cannot read the config of ct $id"
  [[ -n "$config" ]] || pve_check_fail "cannot read the config of ct $id: empty answer"
  ostype="$(pve_config_value ostype <<< "$config")"
  case "$ostype" in
    debian|ubuntu|devuan)
      pm=apt
      refresh="apt-get update"
      sim=(env LC_ALL=C apt-get -s dist-upgrade)
      update=(env DEBIAN_FRONTEND=noninteractive apt-get update)
      upgrade=(env DEBIAN_FRONTEND=noninteractive apt-get -y
               -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold dist-upgrade)
      ;;
    alpine)
      pm=apk
      refresh="apk update"
      sim=(apk upgrade --simulate)
      update=(apk update)
      upgrade=(apk upgrade)
      ;;
    *) pve_check_fail "unsupported ostype '${ostype:-unknown}': apt (debian, ubuntu, devuan) and apk (alpine) only" ;;
  esac
  pve_check_ok "ct $id on $node uses $pm ($ostype)"
  status="$(pve_guest_status "$node" ct "$id")" || pve_check_fail "cannot read the status of ct $id"
  [[ -n "$status" ]] || pve_check_fail "cannot read the status of ct $id: empty answer"
  [[ "$status" == running ]] || pve_check_fail "ct $id is $status: start it first"
  pve_check_ok "ct $id is running"
  if ((simulate == 1)); then
    log_info "the simulation runs through the admin alias (pct exec), without --yes"
    simulate ""
    printf 'simulation: %d packages would be upgraded or installed, %d removed\n' "$SIM_COUNT" "$PVE_REMOVAL_COUNT"
    ((PVE_REMOVAL_COUNT == 0)) || pve_check_warn "the upgrade would remove packages ($PVE_REMOVALS)"
    printf 'note: %s was not run: the simulation reads the package lists as last refreshed; the upgrade refreshes them first\n' \
      "$refresh"
    exit 0
  fi
  if ((snapshot == 1)); then
    snap="pre-update-$(date +%Y%m%d-%H%M)"
    rc=0
    pve_guest_has_snapshot "$node" ct "$id" "$snap" || rc=$?
    ((rc != 2)) || pve_check_fail "cannot read the snapshots of ct $id"
    ((rc != 0)) || pve_check_fail "ct $id already has a snapshot named $snap: wait a minute and retry"
    pve_check_ok "snapshot name $snap is unused"
    pve_require_snapshot_capable "$node" ct "$id"
  fi
  # The plan must show what the upgrade would remove, so the simulation comes first: the only admin
  # call before the confirmation, and a read-only one.
  log_info "the simulation runs through the admin alias (pct exec), without --yes"
  simulate pre-upgrade
  show_simulation pre-upgrade
  before="$PVE_REMOVALS"
  ((PVE_DRY_RUN == 0)) ||
    printf 'note: %s was not run: the simulation reads the package lists as last refreshed; a real run refreshes them and simulates again before the upgrade\n' \
      "$refresh"
  pve_plan_reset
  pve_hint target "ct $id on $node"
  pve_hint path standard
  if ((snapshot == 1)); then
    pve_hint rollback "pct rollback $id $snap"
    pve_plan_add "$node" pct snapshot "$id" "$snap"
  else
    pve_hint rollback "none: pass --snapshot, or take one with bin/pve-snapshot first"
  fi
  pve_hint baseline/after "bin/pve-state $id"
  pve_plan_add "$node" pct exec "$id" -- "${update[@]}"
  if ((PVE_DRY_RUN == 1)); then
    pve_plan_add "$node" pct exec "$id" -- "${upgrade[@]}"
    pve_plan_execute "Upgrade the packages of ct $id on $node?" || exit 1
    exit 0
  fi
  # Phase 1: the snapshot (if any) and the refresh of the package lists. Phase 2, the upgrade,
  # starts only after a simulation on the fresh lists, which can remove more than the first one.
  total=$((${#PVE_PLAN[@]} + 1))
  pve_plan_numbering 0 "$total"
  pve_plan_execute "Run $refresh in ct $id on $node, then (after a fresh simulation) the upgrade?" || exit 1
  simulate post-update
  show_simulation post-update
  if [[ "$PVE_REMOVALS" != "$before" ]]; then
    # the approval covered the list shown before the refresh
    printf 'removals after %s: %s (before: %s)\n' "$refresh" "${PVE_REMOVALS:-none}" "${before:-none}"
    ((PVE_YES == 0)) || pve_check_fail "the removal list changed after $refresh: review it, then run the tool again"
  fi
  ran="$refresh"
  ((snapshot == 0)) || ran="the snapshot and $refresh"
  pve_plan_reset
  pve_plan_add "$node" pct exec "$id" -- "${upgrade[@]}"
  pve_plan_numbering $((total - 1)) "$total"
  pve_plan_execute "Upgrade the packages of ct $id on $node ($SIM_COUNT to upgrade or install, $PVE_REMOVAL_COUNT to remove)?" \
    "cancelled: $ran ran; the upgrade was not run" || exit 1
  if ((snapshot == 1)); then
    rc=0
    pve_guest_has_snapshot "$node" ct "$id" "$snap" || rc=$?
    ((rc != 2)) || pve_verify_fail "cannot read the snapshots of ct $id after the command"
    ((rc == 0)) || pve_verify_fail "snapshot $snap is not listed after the command"
    pve_verify_ok "snapshot $snap is listed"
  fi
  status="$(pve_guest_status "$node" ct "$id")" || status="unknown"
  if [[ "$status" == running ]]; then
    pve_verify_ok "ct $id is running"
  else
    pve_verify_fail "ct $id is $status after the upgrade"
  fi
  out="$(pve_ct_exec_admin "$node" "$id" "${sim[@]}")" || pve_verify_fail "the simulation after the upgrade failed"
  sim_valid "$pm" <<< "$out" || pve_verify_fail "the simulation after the upgrade returned no summary line"
  if [[ "$(pve_parse_pkg_sim "$pm" <<< "$out")" == 0 ]]; then
    pve_verify_ok "no package left to upgrade"
  else
    pve_verify_fail "packages are still pending in ct $id"
  fi
}

main "$@"
