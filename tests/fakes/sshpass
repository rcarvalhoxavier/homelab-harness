#!/usr/bin/env python3
"""Fake sshpass: only `-e` with SSHPASS in the environment is legal; anything else is recorded."""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
if not args or args[0] != "-e" or "SSHPASS" not in os.environ:
    scenario = json.loads(Path(os.environ["FAKE_SSH_SCENARIO"]).read_text())
    with open(scenario["log"], "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"tool": "sshpass", "misuse": args[:2]}) + "\n")
    sys.exit(99)
os.execvp(args[1], args[1:])
